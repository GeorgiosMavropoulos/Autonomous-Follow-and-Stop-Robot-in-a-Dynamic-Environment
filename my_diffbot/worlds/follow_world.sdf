        </visual>
      </link>
    </model>
    <!-- ===== FLOOR CRATES / PALLETS ===== -->

    <model name="crate_floor_0a">
      <static>true</static>
      <pose>-5.4 3.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
