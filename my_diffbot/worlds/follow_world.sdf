<?xml version="1.0"?>
<sdf version="1.9">
  <world name="follow_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===== FLOOR (slightly lowered to avoid z-fighting with the GUI grid) ===== -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>14 10</size></plane></geometry>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>14 10</size></plane></geometry>
          <material>
  <ambient>0.62 0.65 0.69 1</ambient>
  <diffuse>0.62 0.65 0.69 1</diffuse>
  <specular>0.25 0.25 0.25 1</specular>
  <shininess>35</shininess>
</material>
        </visual>
      </link>
    </model>

    <!-- ===== WALLS ===== -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.2 0.2 2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>12.2 0.2 2</size></box></geometry>
          <material>
  <ambient>0.55 0.62 0.72 1</ambient>
  <diffuse>0.55 0.62 0.72 1</diffuse>
  <specular>0.18 0.18 0.18 1</specular>
</material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
