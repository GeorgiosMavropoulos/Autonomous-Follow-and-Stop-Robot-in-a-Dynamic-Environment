          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- ===== SHELVES (solid blocks) ===== -->

    <model name="shelf_north">
      <static>true</static>
      <pose>1 1.4 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.8 1.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6 0.8 1.8</size></box></geometry>
          <material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material>
